# ==============================================================================
# StreamLite Local Development Environment Configuration
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL (6 Dedicated Service Databases)
# ------------------------------------------------------------------------------
# Auth Service DB (Mapped to 5438 to prevent conflicts if host has Postgres on 5432)
AUTH_DB_PORT=5438
AUTH_DB_USER=auth
AUTH_DB_NAME=auth_db
AUTH_DB_PASS=10273
AUTH_DB_URL=postgres://auth:10273@localhost:5438/auth_db

# Catalog Service DB
CATALOG_DB_PORT=5433
CATALOG_DB_USER=catalog
CATALOG_DB_NAME=catalog_db
CATALOG_DB_PASS=10273
CATALOG_DB_URL=postgres://catalog:10273@localhost:5433/catalog_db

# Upload Service DB
UPLOAD_DB_PORT=5434
UPLOAD_DB_USER=upload
UPLOAD_DB_NAME=upload_db
UPLOAD_DB_PASS=10273
UPLOAD_DB_URL=postgres://upload:10273@localhost:5434/upload_db

# Transcoder Service DB
TRANSCODER_DB_PORT=5435
TRANSCODER_DB_USER=transcoder
TRANSCODER_DB_NAME=transcoder_db
TRANSCODER_DB_PASS=10273
TRANSCODER_DB_URL=postgres://transcoder:10273@localhost:5435/transcoder_db

# Watch History Service DB
WATCH_DB_PORT=5436
WATCH_DB_USER=watch
WATCH_DB_NAME=watch_db
WATCH_DB_PASS=10273
WATCH_DB_URL=postgres://watch:10273@localhost:5436/watch_db

# Recommendation Service DB
RECO_DB_PORT=5437
RECO_DB_USER=reco
RECO_DB_NAME=reco_db
RECO_DB_PASS=10273
RECO_DB_URL=postgres://reco:10273@localhost:5437/reco_db

# ------------------------------------------------------------------------------
# Redis 7
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Redpanda (Kafka-compatible Event Broker)
# ------------------------------------------------------------------------------
KAFKA_BROKER_PORT=19092
KAFKA_INTERNAL_BROKER=redpanda:9092
KAFKA_ADMIN_PORT=9644
KAFKA_BROKERS=localhost:19092

# ------------------------------------------------------------------------------
# SeaweedFS (Local S3 Object Store)
# ------------------------------------------------------------------------------
S3_PORT=8333
S3_FILER_PORT=8888
S3_KEY=streamlite_dev_key
S3_SECRET=streamlite_dev_secret
S3_REGION=us-east-1
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_RAW_BUCKET=raw
S3_MEDIA_BUCKET=media
S3_IMAGES_BUCKET=images

# ------------------------------------------------------------------------------
# Mailpit (Dev SMTP Catcher & Web Mailbox)
# ------------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ------------------------------------------------------------------------------
# Edge & Secrets
# ------------------------------------------------------------------------------
MEDIA_SECRET=dev_media_edge_signing_secret_key_32
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_streamlite_32
UV_THREADPOOL_SIZE=8
