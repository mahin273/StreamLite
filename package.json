{
  "name": "streamlite-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "tsc -b --noEmit",
    "clean": "npm run clean --workspaces --if-present",
    "proto:lint": "buf lint proto",
    "proto:generate": "buf generate proto"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "ts-proto": "^2.18.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
